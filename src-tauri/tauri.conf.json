{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "南荒白板",
  "version": "0.1.2",
  "identifier": "com.nanhara.board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "南荒白板",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; img-src 'self' asset: https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 无锡南荒科技有限公司",
    "category": "Productivity",
    "shortDescription": "面向触摸大屏的本地优先白板",
    "longDescription": "支持本地白板、演示批注和客户欢迎屏的南荒桌面工具。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
